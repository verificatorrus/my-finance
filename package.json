{
	"name": "my-finance",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "cross-env CLOUDFLARE_ENV=dev vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:dev": "wrangler d1 execute my-finance-dev --remote --file=./db/migrations/0000_initial.sql --env=dev",
		"db:migrate:prod": "wrangler d1 execute my-finace-prod --remote --file=./db/migrations/0000_initial.sql",
		"db:migrate:transactions:dev": "wrangler d1 execute my-finance-dev --remote --file=./db/migrations/0001_add_transactions.sql --env=dev",
		"db:migrate:transactions:prod": "wrangler d1 execute my-finace-prod --remote --file=./db/migrations/0001_add_transactions.sql",
		"db:migrate:archived:dev": "wrangler d1 execute my-finance-dev --remote --file=./db/migrations/0002_add_wallet_archived.sql --env=dev",
		"db:migrate:archived:prod": "wrangler d1 execute my-finace-prod --remote --file=./db/migrations/0002_add_wallet_archived.sql",
		"db:migrate:currency-index:dev": "wrangler d1 execute my-finance-dev --remote --file=./db/migrations/0003_add_currency_rates_index.sql --env=dev",
		"db:migrate:currency-index:prod": "wrangler d1 execute my-finace-prod --remote --file=./db/migrations/0003_add_currency_rates_index.sql",
		"db:migrate:cleanup-rates:dev": "wrangler d1 execute my-finance-dev --remote --file=./db/migrations/0004_cleanup_currency_rates.sql --env=dev",
		"db:migrate:cleanup-rates:prod": "wrangler d1 execute my-finace-prod --remote --file=./db/migrations/0004_cleanup_currency_rates.sql",
		"db:migrate:optimize-rates:dev": "wrangler d1 execute my-finance-dev --remote --file=./db/migrations/0005_optimize_currency_rates.sql --env=dev",
		"db:migrate:optimize-rates:prod": "wrangler d1 execute my-finace-prod --remote --file=./db/migrations/0005_optimize_currency_rates.sql",
		"db:migrate:fix-rates:dev": "wrangler d1 execute my-finance-dev --remote --file=./db/migrations/0006_fix_currency_rates.sql --env=dev",
		"db:migrate:fix-rates:prod": "wrangler d1 execute my-finace-prod --remote --file=./db/migrations/0006_fix_currency_rates.sql",
		"test:cron": "curl -X POST 'http://localhost:5173/api/update-rates'",
		"android:sync": "npm run build && npx cap sync android",
		"android:open": "npx cap open android",
		"android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
		"android:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease"
	},
	"dependencies": {
		"@capacitor/android": "^8.0.0",
		"@capacitor/cli": "^8.0.0",
		"@capacitor/core": "^8.0.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@hono/firebase-auth": "^1.4.2",
		"@mui/icons-material": "^7.3.6",
		"@mui/material": "^7.3.6",
		"better-sqlite3": "^12.5.0",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"firebase": "^12.6.0",
		"hono": "^4.10.8",
		"nanoid": "^5.1.6",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"recharts": "^3.6.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.17.1",
		"@eslint/js": "^9.33.0",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@types/recharts": "^1.8.29",
		"@vitejs/plugin-react": "^5.0.0",
		"cross-env": "^10.1.0",
		"eslint": "^9.33.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.3.0",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.39.1",
		"vite": "^7.1.2",
		"wrangler": "^4.54.0"
	}
}
